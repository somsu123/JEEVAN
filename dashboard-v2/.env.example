# ─── Core ────────────────────────────────────────────────────────────────────
# Gemini API Key — required for AI voice assistant and report scanning
GEMINI_API_KEY="your_gemini_api_key_here"

# Flask backend URL (existing ElderCare backend on port 5000)
FLASK_BACKEND_URL="http://localhost:5000"

# Port for this Node/Express bridge server
PORT=5050

# ─── Gmail — Fall Alerts + Missed Dose Alerts ─────────────────────────────────
# Create an App Password: Google Account → Security → 2-Step → App Passwords
GMAIL_USER="your_gmail@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Where fall + missed-dose emails go (can be same as GMAIL_USER)
CAREGIVER_EMAIL="caregiver@email.com"

# ─── Twilio SMS — Fall Alerts ─────────────────────────────────────────────────
# Sign up free at https://www.twilio.com — get $15 trial credit
# Account SID and Auth Token from: https://console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"

# Your Twilio phone number (from Twilio console) — format: +1XXXXXXXXXX
TWILIO_FROM_NUMBER="+12025551234"

# Caregiver's phone number to receive SMS — include country code
# India example: +919876543210   |   International: +447911123456
CAREGIVER_PHONE="+919876543210"
